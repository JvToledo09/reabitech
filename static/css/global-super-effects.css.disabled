
/* =======================================================
   REABITECH - SUPER UPGRADE DE EFEITOS E MOVIMENTOS
   ======================================================= */

/* 1. EFEITO 3D EM CARDS DO SISTEMA INTEIRO */
.card, .stat-card, .glass-card, .dashboard-card, .action-card, .chart-card, [class*="card"] {
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, border-color 0.4s ease !important;
    position: relative;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
}

/* O Hover Potente (Sobrescreve qualquer trava anterior) */
.card:hover, .stat-card:hover, .glass-card:hover, .dashboard-card:hover, .action-card:hover, .chart-card:hover, [class*="card"]:hover {
    transform: translateY(-8px) scale(1.02) !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(43, 161, 129, 0.4) !important;
    border-color: #2BA181 !important;
    z-index: 100 !important;
}

/* Efeito de Shine (Brilho passando por cima) */
.card::after, .stat-card::after, .glass-card::after, .dashboard-card::after {
    content: '';
    position: absolute;
    top: 0; left: -150%;
    width: 50%; height: 100%;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: skewX(-25deg);
    transition: left 0.7s ease;
    pointer-events: none;
    border-radius: inherit;
}

.card:hover::after, .stat-card:hover::after, .glass-card:hover::after, .dashboard-card:hover::after {
    left: 150%;
}

/* 2. EFEITO NO MENU LATERAL (SIDEBAR) */
.sidebar .nav-link, .sidebar .list-group-item {
    transition: all 0.3s ease !important;
    position: relative;
}
.sidebar .nav-link:hover, .sidebar .list-group-item:hover {
    background: rgba(43, 161, 129, 0.15) !important;
    padding-left: 30px !important; /* Desliza o texto */
    border-left: 4px solid #2BA181 !important;
    color: #fff !important;
    box-shadow: inset 0 0 15px rgba(43, 161, 129, 0.1);
}

/* 3. EFEITOS NOS BOTÕES */
.btn, .btn-custom, .btn-primary {
    transition: all 0.3s ease !important;
}
.btn:hover, .btn-custom:hover, .btn-primary:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 10px 20px rgba(43, 161, 129, 0.4) !important;
    filter: brightness(1.1);
}

/* 4. ÍCONES FLUTUANTES NOS CARDS */
.card i, .stat-card i, .dashboard-card i, .action-card i {
    transition: all 0.4s ease;
}
.card:hover i, .stat-card:hover i, .dashboard-card:hover i, .action-card:hover i {
    transform: scale(1.2) rotate(5deg) !important;
    color: #2BA181 !important;
}
