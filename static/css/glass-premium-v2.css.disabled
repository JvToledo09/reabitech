
/* =======================================================
   REABITECH - LAYOUT BLINDADO (SEM BUGS)
   ======================================================= */

@media (min-width: 992px) {
    /* Desktop: Menu Fixo na Esquerda */
    .sidebar {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        bottom: 0 !important;
        width: 260px !important;
        background: #0f172a !important; /* Fundo escuro sólido */
        border-right: 1px solid rgba(255, 255, 255, 0.05) !important;
        z-index: 1040 !important;
        overflow-y: auto !important;
        transform: none !important;
    }

    /* O conteúdo principal ocupa o resto da tela */
    .main-content {
        margin-left: 260px !important;
        width: calc(100% - 260px) !important;
        padding: 24px !important;
        min-height: 100vh !important;
    }

    /* Esconde botões de mobile no Desktop */
    .mobile-menu-btn, .hamburger, .menu-toggle, #mobileMenuBtn, .lp-nav-toggle {
        display: none !important;
    }
}

/* =======================================================
   MOBILE (Gaveta Deslizante)
   ======================================================= */
@media (max-width: 991px) {
    .main-content {
        margin-left: 0 !important;
        width: 100% !important;
        padding: 80px 16px 20px 16px !important; 
    }

    .sidebar {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        bottom: 0 !important;
        width: 260px !important;
        background: #0f172a !important;
        z-index: 9999 !important;
        transform: translateX(-100%) !important;
        transition: transform 0.3s ease !important;
    }

    /* Mostra o menu quando a classe for ativada */
    .sidebar.active, .sidebar.show, body.sidebar-toggled .sidebar {
        transform: translateX(0) !important;
    }

    /* Dropdowns presos na tela */
    .dropdown-menu {
        position: absolute !important;
        right: 0 !important;
        left: auto !important;
        z-index: 10000 !important;
    }

    /* Cards em 100% da tela */
    .row { margin-left: 0 !important; margin-right: 0 !important; }
    [class*="col-"], .card { 
        width: 100% !important; 
        padding-left: 8px !important; 
        padding-right: 8px !important; 
        margin-bottom: 16px !important; 
    }
}
