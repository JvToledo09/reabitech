# ==============================================================================
# REABITECH — Variáveis de ambiente
# Copie para .env e preencha com valores reais
# ==============================================================================

# Django
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=False

# Hosts permitidos (separe com vírgula)
ALLOWED_HOSTS=seu-usuario.pythonanywhere.com,localhost,127.0.0.1

# CSRF trusted origins (com https:// na frente)
CSRF_TRUSTED_ORIGINS=https://seu-usuario.pythonanywhere.com

# Banco (deixe em branco para usar SQLite)
# No PythonAnywhere gratuito, use SQLite (deixe DATABASE_URL vazio)
# No Render, use PostgreSQL (preencha com a URL fornecida)
DATABASE_URL=

# Email (opcional — pra recuperação de senha)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=REABITECH <nao-responda@reabitech.com>
