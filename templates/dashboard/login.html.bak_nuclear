{% extends 'base.html' %}
{% load static %}
{% block title %}Entrar - REABITECH{% endblock %}

{% block extra_css %}
<style>
    .auth-immersive {
        --text-primary: #f1f5f9 !important;
        --text-secondary: #cbd5e1 !important;
        --text-tertiary: #94a3b8 !important;
        --bg-primary: #050b14 !important;
        --bg-secondary: #0f172a !important;
        --bg-elevated: #1e293b !important;
        --border-color: rgba(148, 163, 184, 0.1) !important;
        --border-strong: rgba(148, 163, 184, 0.2) !important;
    }

    /* FIX DEFINITIVO DA LOGO E TEXTOS */
    .auth-brand-name {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-size: 1.8rem !important; /* Tamanho controlado */
        font-weight: 800 !important;
        letter-spacing: 0.05em !important;
        text-shadow: none !important; /* Remove o brilho exagerado */
        color: white !important;
        white-space: nowrap !important;
        position: relative !important;
        z-index: 10 !important;
    }
    .auth-brand-name span {
        display: block !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.1em !important;
        color: rgba(255, 255, 255, 0.6) !important;
        margin-top: 4px !important;
    }
    .auth-brand-header {
        display: flex !important;
        align-items: center !important;
        gap: 16px !important;
    }
    /* Esconde qualquer texto solto que tenha vazado para o body */
    body > h1, body > h2 { display: none !important; }
</style>
<link rel="stylesheet" href="{% static 'css/login-cyber.css' %}">

<style>
    /* ESCONDE A NAVBAR GLOBAL E O HAMBURGUER NO LOGIN */
    .sidebar, .top-navbar, .mobile-header, #sidebar, .hamburger, .menu-toggle, .navbar { display: none !important; }
    
    /* DESTRAVA O SCROLL E O TAMANHO */
    body, html { overflow-y: auto !important; height: auto !important; }
    .main-content { margin: 0 !important; padding: 0 !important; width: 100vw !important; max-width: 100vw !important; }
    
    /* AJUSTA O FUNDO ESCURO DO LOGIN NO MOBILE */
    @media (max-width: 992px) {
        .auth-immersive { height: 100dvh !important; min-height: 100dvh !important; overflow-y: auto !important; overflow-x: hidden !important; display: block !important; }
        .auth-content { padding: 30px 16px !important; margin-top: 0 !important; }
        .auth-logo-box { width: 70px !important; height: 70px !important; margin-bottom: 10px !important; }
    }
</style>
{% endblock %}

{% block content %}
<div class="auth-immersive">
    <canvas id="login-particles"></canvas>

    <div class="auth-container">
        <!-- LADO ESQUERDO: BRANDING -->
        <div class="auth-brand">
            <div class="auth-brand-header">
                <div class="auth-logo-box">
                    <img src="{% static 'images/logo.png' %}" alt="Logo REABITECH" onerror="this.style.display='none'">
                </div>
                <div class="auth-brand-name">
                    REABITECH
                    <span>Soluções em Reabilitação</span>
                </div>
            </div>

            <div class="auth-hero-text">
                <div class="auth-eyebrow">Plataforma Clínica</div>
                <h1 class="auth-title">
                    Reabilitação<br>
                    <span class="auth-title-accent">em movimento.</span>
                </h1>
                <p class="auth-desc">
                    Fisioterapia, psicologia e performance integradas em uma única plataforma multi-tenant.
                </p>
            </div>

            <div class="auth-footer">
                <div class="auth-status">
                    <span class="auth-status-dot"></span> Sinal Ativo
                </div>
                <div>V8.0 · 2026</div>
            </div>
        </div>

        <!-- LADO DIREITO: FORMULÁRIO -->
        <div class="auth-form-side">
            <div class="auth-glass-card">
                <div class="auth-form-header">
                    <h2 class="auth-form-title">Bem-vindo de volta.</h2>
                    <p class="auth-form-subtitle">Acesse sua conta para continuar.</p>
                </div>

                {% if messages %}
                    {% for message in messages %}
                        {% if 'error' in message.tags or 'danger' in message.tags %}
                        <div class="auth-alert">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>{{ message }}</span>
                        </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}

                <form method="post" class="auth-form" autocomplete="on">
                    {% csrf_token %}
                    
                    <div class="auth-field">
                        <label for="id_username">Usuário, e-mail ou RM</label>
                        <div class="auth-input-wrap">
                            <input type="text" name="username" id="id_username" class="auth-input" placeholder="seu@email.com" required autofocus autocomplete="username">
                        </div>
                    </div>

                    <div class="auth-field">
                        <label for="id_password">Senha</label>
                        <div class="auth-input-wrap">
                            <input type="password" name="password" id="id_password" class="auth-input" placeholder="••••••••" required autocomplete="current-password">
                            <button type="button" class="auth-eye" onclick="togglePassword()" aria-label="Mostrar senha">
                                <i class="fas fa-eye" id="togglePassIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-meta">
                        <label class="auth-check">
                            <input type="checkbox" name="remember_me" value="1">
                            <span>Lembrar de mim</span>
                        </label>
                        <a href="#" class="auth-link">Esqueceu a senha?</a>
                    </div>

                    <button type="submit" class="auth-btn">
                        <span>Entrar na plataforma</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>

                <a href="/" class="auth-back">
                    <i class="fas fa-arrow-left" style="margin-right: 8px;"></i> Voltar ao início
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="{% static 'js/login-particles.js' %}"></script>
<script>
function togglePassword() {
    var input = document.getElementById('id_password');
    var icon = document.getElementById('togglePassIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
}

// Efeito 3D Suave (Máx 3 graus)
const card = document.querySelector('.auth-glass-card');
const side = document.querySelector('.auth-form-side');
if (card && side) {
    side.addEventListener('mousemove', (e) => {
        const rect = side.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const rotY = Math.max(Math.min(x * 6, 3), -3);
        const rotX = Math.max(Math.min(-y * 6, 3), -3);
        card.style.transform = `perspective(1000px) rotateY(${rotY}deg) rotateX(${rotX}deg)`;
    });
    side.addEventListener('mouseleave', () => {
        card.style.transform = `perspective(1000px) rotateY(0deg) rotateX(0deg)`;
    });
}
</script>
{% endblock %}
