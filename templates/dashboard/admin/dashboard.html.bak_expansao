{% extends 'base.html' %}
{% load static %}

{% block title %}Painel do Dono - REABITECH{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Visão Geral do SaaS</h2>
            <p class="text-muted mb-0">Controle total sobre clientes, planos e faturamento.</p>
        </div>
        <a href="#" class="btn btn-primary">+ Novo Cliente</a>
    </div>

    <!-- Cards de Métricas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0" style="background: var(--bg-elevated);">
                <h6 class="text-muted">Receita Mensal (MRR)</h6>
                <h2 class="fw-bold text-success">R$ {{ receita_estimada|floatformat:2 }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0" style="background: var(--bg-elevated);">
                <h6 class="text-muted">Clientes Ativos</h6>
                <h2 class="fw-bold">{{ total_clientes }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0" style="background: var(--bg-elevated);">
                <h6 class="text-muted">Usuários Cadastrados</h6>
                <h2 class="fw-bold">{{ total_usuarios }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm border-0" style="background: var(--bg-elevated);">
                <h6 class="text-muted">Planos Disponíveis</h6>
                <h2 class="fw-bold">{{ total_planos }}</h2>
            </div>
        </div>
    </div>

    <!-- Tabela de Projetos Recentes -->
    <div class="card shadow-sm border-0" style="background: var(--bg-elevated);">
        <div class="card-header border-0 bg-transparent pt-3">
            <h5 class="fw-bold mb-0">Últimos Clientes Assinantes</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nome do Projeto</th>
                            <th>Coordenador</th>
                            <th>Plano Atual</th>
                            <th>Data de Cadastro</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for projeto in projetos_recentes %}
                        <tr>
                            <td>{{ projeto.nome }}</td>
                            <td>{{ projeto.coordenador.get_full_name }}</td>
                            <td>{{ projeto.plano.nome|default:"Sem plano" }}</td>
                            <td>{{ projeto.criado_em|date:"d/m/Y" }}</td>
                            <td><a href="#" class="btn btn-sm btn-outline-primary">Gerenciar</a></td>
                        </tr>
                        {% empty %}
                        <tr>
                            <td colspan="5" class="text-center text-muted">Nenhum cliente cadastrado.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
