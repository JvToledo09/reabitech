{% extends 'registration/auth_base.html' %}

{% block title %}Recuperar senha | REABITECH{% endblock %}

{% block content %}
<div class="auth-icon"><i class="fa-solid fa-shield-halved"></i></div>
<div class="auth-eyebrow">Recuperação de acesso</div>
<h1 class="auth-title">Esqueceu sua senha?</h1>
<p class="auth-description">
    Sem problemas. Informe o e-mail associado à sua conta e enviaremos as instruções para criar uma nova senha.
</p>

{% if form.non_field_errors %}
    <div class="auth-alert mb-3">{{ form.non_field_errors }}</div>
{% endif %}

<form method="post" novalidate>
    {% csrf_token %}
    <div class="mb-3">
        <label for="id_email" class="form-label">E-mail cadastrado</label>
        <input
            type="email"
            name="email"
            id="id_email"
            class="form-control"
            placeholder="voce@exemplo.com"
            value="{{ form.email.value|default_if_none:'' }}"
            autocomplete="email"
            required
            autofocus
        >
        {% if form.email.errors %}
            <div class="text-danger small mt-2">{{ form.email.errors }}</div>
        {% endif %}
    </div>
    <button type="submit" class="btn-auth">
        Enviar instruções <i class="fa-solid fa-arrow-right"></i>
    </button>
</form>

<div class="text-center">
    <a class="auth-back" href="{% url 'login' %}">
        <i class="fa-solid fa-arrow-left"></i> Voltar para o login
    </a>
</div>
{% endblock %}
