
/* ==========================================================================
   REABITECH - MOBILE ULTIMATE FIX (V3)
   REGRA DE OURO: TUDO AQUI ESTA DENTRO DE @media (max-width: 991px)
   O PC NAO E AFETADO POR ESTE ARQUIVO.
   ========================================================================== */

@media (max-width: 991.98px) {
    /* --- 1. DESTRAVAR ROLAGEM (LOGIN E TELAS) --- */
    html, body {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        height: auto !important;
        min-height: 100vh !important;
        display: block !important;
    }
    
    /* Remove a centralizacao vertical que corta o login */
    .vh-100, .min-vh-100, .h-100, .login-wrapper, .auth-container, .d-flex.align-items-center {
        align-items: flex-start !important; /* Joga pro topo */
        justify-content: flex-start !important;
        height: auto !important;
        min-height: 100vh !important;
        overflow-y: visible !important;
        padding-top: 80px !important; /* Espaco pro botao hamburguer */
        padding-bottom: 50px !important; /* Espaco pro teclado do celular */
    }

    /* O card do login precisa de margem pra nao colar nas bordas */
    .login-card, .auth-card, .card-login, .card-modern {
        margin-top: 20px !important;
        margin-bottom: 40px !important;
        max-width: 100% !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
    }

    /* --- 2. FIX DA NAVBAR (DASHBOARD) --- */
    /* Empurra a navbar pra direita para nao ficar embaixo do botao hamburguer */
    .top-navbar {
        margin-left: 75px !important; /* Espaco exato do botao hamburguer */
        margin-right: 15px !important;
        margin-top: 10px !important;
        padding: 12px 15px !important;
        display: flex !important;
        flex-direction: row !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: nowrap !important;
        width: auto !important;
        border-radius: 14px !important;
    }
    
    .top-navbar .page-title {
        flex: 1 !important;
        min-width: 0 !important;
        margin-right: 10px !important;
    }
    
    .top-navbar .page-title h2 {
        font-size: 1rem !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        margin: 0 !important;
    }
    
    /* Esconde subtitulos para nao esmagar */
    .top-navbar .page-title p, 
    .top-navbar .page-title span { 
        display: none !important; 
    }

    /* Icones da direita nao encolhem */
    .top-navbar .d-flex, .top-navbar .nav-actions {
        flex-shrink: 0 !important;
        gap: 8px !important;
    }
    .top-navbar .btn-icon, .top-navbar .avatar {
        width: 38px !important;
        height: 38px !important;
    }

    /* --- 3. MAIN CONTENT (ESPACAMENTO E CARDS) --- */
    .main-content, .main-content:not(.no-sidebar) {
        margin-left: 0 !important;
        padding: 15px 15px 100px 15px !important; /* Margem e espaco embaixo pros botoes */
        width: 100% !important;
        max-width: 100vw !important;
        box-sizing: border-box !important;
    }

    /* Cards ocupam 100% e quebram linha */
    .card, .card-modern, .card-premium, .coord-section, .dash-section, .custom-card {
        width: 100% !important;
        max-width: 100% !important;
        margin-bottom: 15px !important;
        padding: 15px !important;
        box-sizing: border-box !important;
    }

    /* Titulos dos cards */
    .card-header, .coord-section-head, .dash-section-head {
        flex-wrap: wrap !important;
        gap: 10px !important;
    }
    .card-header h5, .coord-section-title, .dash-section-title {
        font-size: 1.05rem !important;
        width: 100% !important; 
    }

    /* --- 4. TOASTS E AVISOS --- */
    /* Forca os avisos a irem para a parte de baixo e nao sobrepor o menu */
    .toast-container, .messages-container, .alert, .alert-dismissible {
        position: fixed !important;
        top: auto !important;
        bottom: 80px !important; /* Acima do botao flutuante */
        left: 15px !important;
        right: 15px !important;
        width: auto !important;
        z-index: 10010 !important;
        margin: 0 !important;
    }

    /* --- 5. BOTOES FLUTUANTES --- */
    .floating-btn, .chat-widget, .theme-toggle-global {
        bottom: 20px !important;
        right: 15px !important;
        transform: scale(0.9) !important;
        z-index: 9990 !important;
    }

    /* --- 6. TABELAS --- */
    .table-responsive, table, .dash-table, .consulta-table, .membros-table {
        display: block !important;
        width: 100% !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
        white-space: nowrap !important;
    }

    /* --- 7. SIDEBAR E BOTAO HAMBURGUER --- */
    .sidebar {
        z-index: 10006 !important;
    }
    .mobile-menu-btn {
        display: flex !important;
        position: fixed;
        top: 15px;
        left: 15px;
        z-index: 10005;
        background: var(--bg-elevated, #fff);
        border: 1px solid var(--border-color, #ddd);
        color: var(--text-primary, #000);
        width: 46px; 
        height: 46px;
        border-radius: 12px;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
}


/* =======================================================
   FIX GLOBAL PARA TELAS INTERNAS (PROJETOS/DASHBOARDS)
   ======================================================= */
@media (max-width: 992px) {
    /* Impede vazamento horizontal na tela toda */
    html, body { overflow-x: hidden !important; width: 100% !important; max-width: 100vw !important; }
    
    /* Tabelas: transforma em scroll horizontal para não quebrar o layout */
    .table-responsive, .table-container { 
        display: block !important; 
        width: 100% !important; 
        overflow-x: auto !important; 
        -webkit-overflow-scrolling: touch !important; 
    }
    table { width: 100% !important; min-width: 600px; /* força o scroll em vez de esmagar */ }
    
    /* Grids do Bootstrap: força tudo para 1 coluna no celular */
    .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-5, .col-md-6,
    .col-md-7, .col-md-8, .col-md-9, .col-md-10, .col-md-11, .col-md-12,
    .col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6,
    .col-lg-7, .col-lg-8, .col-lg-9, .col-lg-10, .col-lg-11, .col-lg-12,
    .col-sm-1, .col-sm-2, .col-sm-3, .col-sm-4, .col-sm-5, .col-sm-6,
    .col-sm-7, .col-sm-8, .col-sm-9, .col-sm-10, .col-sm-11, .col-sm-12 {
        flex: 0 0 100% !important; 
        max-width: 100% !important; 
        width: 100% !important; 
        margin-bottom: 16px !important;
    }
    
    /* Margens e paddings do conteúdo principal */
    .main-content, .container-fluid { 
        margin-left: 0 !important; 
        padding-left: 16px !important; 
        padding-right: 16px !important; 
        width: 100vw !important; 
        max-width: 100vw !important; 
        box-sizing: border-box !important; 
    }
    
    /* Cards não vazam */
    .card, .glass-card, .stat-card { width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; }
}


/* =======================================================
   FIX DE SIDEBAR MOBILE (MATAR A MARGEM E EMPURRÃO)
   ======================================================= */
@media (max-width: 992px) {
    /* Esconde a sidebar por padrão no mobile */
    .sidebar, #sidebar, .glass-sidebar, aside.sidebar { 
        transform: translateX(-100%) !important; 
        position: fixed !important;
        z-index: 1040 !important;
    }
    
    /* Quando o menu estiver aberto (classe adicionada pelo JS), mostra ela */
    .sidebar.active, #sidebar.active, .sidebar.show, .sidebar.open { 
        transform: translateX(0) !important; 
    }
    
    /* Destrói a margem do conteúdo que a sidebar estava empurrando */
    .main-content, .content-wrapper, main, .app-content { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100vw !important; 
        padding: 75px 16px 16px 16px !important; 
        overflow-x: hidden !important; 
    }
    
    /* Força os grids do bootstrap a virarem 1 coluna */
    .row > [class*="col-"] { 
        flex: 0 0 100% !important; 
        max-width: 100% !important; 
    }
}


/* =======================================================
   FIX DE EMERGÊNCIA MOBILE (OBRIGA O CONTEÚDO A APARECER)
   ======================================================= */
@media (max-width: 992px) {
    /* Se o JS quebrar, isso impede que a tela fique toda preta */
    .reveal, .fade-in, .aos-init, .aos-animate, .card, .row, .col { 
        opacity: 1 !important; 
        transform: none !important; 
        visibility: visible !important; 
    }
    
    /* Zera a margem do conteúdo principal */
    .main-content, .content-wrapper, main { 
        margin-left: 0 !important; 
        padding: 75px 16px 16px 16px !important; 
        width: 100vw !important; 
        max-width: 100vw !important; 
        overflow-x: hidden !important; 
    }
    
    /* Força os grids e cards a ficarem um embaixo do outro */
    .row { display: flex !important; flex-wrap: wrap !important; margin: 0 !important; }
    [class*="col-"] { flex: 0 0 100% !important; max-width: 100% !important; width: 100% !important; margin-bottom: 16px !important; }
}
